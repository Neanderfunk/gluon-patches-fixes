diff --git a/batman-adv/patches/0103-batman-adv-bla-only-update-backbone-lasttime-on-chan.patch b/batman-adv/patches/0103-batman-adv-bla-only-update-backbone-lasttime-on-chan.patch
new file mode 100644
index 0000000..4350bbb
--- /dev/null
+++ b/batman-adv/patches/0103-batman-adv-bla-only-update-backbone-lasttime-on-chan.patch
@@ -0,0 +1,35 @@
+From: Sven Eckelmann <sven@narfation.org>
+Date: Wed, 29 Jul 2026 23:04:15 +0200
+Subject: batman-adv: bla: only update backbone lasttime on changed claim backbone
+
+The old behavior before commit d88d7ea0d0be ("batman-adv: bla: avoid CRC
+corruption due to parallel claim add") was to only update the
+backbone_gw->lasttime when the backbone_gw of the claim changed. But afte
+the CRC fix, the backbone_gw->lasttime was updated for each handled claim.
+
+Return back to the old behavior and only update it when the backbone_gw was
+changed.
+
+Fixes: d88d7ea0d0be ("batman-adv: bla: avoid CRC corruption due to parallel claim add")
+Signed-off-by: Sven Eckelmann <sven@narfation.org>
+Origin: upstream, https://git.open-mesh.org/batman-adv.git/commit/d0ded7c51e738a4d0e477ca115d4cbf6fcf77b93
+
+--- a/net/batman-adv/bridge_loop_avoidance.c
++++ b/net/batman-adv/bridge_loop_avoidance.c
+@@ -769,6 +769,8 @@ static void batadv_bla_add_claim(struct batadv_priv *bat_priv,
+ 		spin_lock_bh(&backbone_gw->crc_lock);
+ 		backbone_gw->crc ^= claim_crc;
+ 		spin_unlock_bh(&backbone_gw->crc_lock);
++
++		WRITE_ONCE(backbone_gw->lasttime, jiffies);
+ 	}
+ 
+ 	if (old_backbone_gw) {
+@@ -780,7 +782,6 @@ static void batadv_bla_add_claim(struct batadv_priv *bat_priv,
+ 		batadv_backbone_gw_put(old_backbone_gw);
+ 	}
+ 
+-	WRITE_ONCE(backbone_gw->lasttime, jiffies);
+ 	batadv_claim_put(claim);
+ }
+ 
diff --git a/batman-adv/patches/0104-batman-adv-bla-avoid-double-free-after-failed-backbo.patch b/batman-adv/patches/0104-batman-adv-bla-avoid-double-free-after-failed-backbo.patch
new file mode 100644
index 0000000..039cb56
--- /dev/null
+++ b/batman-adv/patches/0104-batman-adv-bla-avoid-double-free-after-failed-backbo.patch
@@ -0,0 +1,29 @@
+From: Sven Eckelmann <sven@narfation.org>
+Date: Tue, 1 Sep 2026 18:29:29 +0200
+Subject: batman-adv: bla: avoid double free after failed backbone_hash alloc
+
+When batadv_bla_init() fails to initialize the backbone_hash, it is freeing
+the (previously) allocated claim_hash. The initialization function will
+then return an error and the net_device initialization will stop. The
+destructor will be called instead and (indirectly via batadv_mesh_free() ->
+batadv_bla_free()) will try to free the bat_priv->bla.claim_hash again.
+
+The pointer must therefore be set to NULL after freeing it in the
+initialization error path.
+
+Reported-by: Sashiko <sashiko-bot@kernel.org>
+Closes: https://sashiko.dev/#/patchset/20260831135117.574836-1-sw%40simonwunderlich.de?part=6
+Fixes: 0631e0825c81 ("batman-adv: fix error handling")
+Signed-off-by: Sven Eckelmann <sven@narfation.org>
+Origin: upstream, https://git.open-mesh.org/batman-adv.git/commit/9c7a6f34298562179691007cf8698d0405891e3c
+
+--- a/net/batman-adv/bridge_loop_avoidance.c
++++ b/net/batman-adv/bridge_loop_avoidance.c
+@@ -1615,6 +1615,7 @@ int batadv_bla_init(struct batadv_priv *bat_priv)
+ 	bat_priv->bla.backbone_hash = batadv_hash_new(32);
+ 	if (!bat_priv->bla.backbone_hash) {
+ 		batadv_hash_destroy(bat_priv->bla.claim_hash);
++		bat_priv->bla.claim_hash = NULL;
+ 		return -ENOMEM;
+ 	}
+ 
diff --git a/batman-adv/patches/0105-batman-adv-avoid-WARN-ON-for-orig-ifinfo-allocation.patch b/batman-adv/patches/0105-batman-adv-avoid-WARN-ON-for-orig-ifinfo-allocation.patch
new file mode 100644
index 0000000..375d896
--- /dev/null
+++ b/batman-adv/patches/0105-batman-adv-avoid-WARN-ON-for-orig-ifinfo-allocation.patch
@@ -0,0 +1,30 @@
+From: Deepanshu Kartikey <kartikey406@gmail.com>
+Date: Sun, 13 Sep 2026 08:49:06 +0530
+Subject: batman-adv: avoid WARN_ON for orig_ifinfo allocation failure
+
+batadv_orig_ifinfo_new() returns NULL only when its GFP_ATOMIC
+allocation fails, which is a normal runtime condition and not a bug.
+batadv_v_ogm_forward() already handles this the same way, simply
+checking for NULL without a WARN_ON.
+
+Do the same in batadv_iv_ogm_update_seqnos() to avoid a spurious
+WARN_ON splat when the allocation fails (e.g. under fault injection).
+
+Fixes: de6bcc76ea84 ("batman-adv: split out router from orig_node")
+Reported-by: syzbot+a079f084653164a652d1@syzkaller.appspotmail.com
+Closes: https://syzkaller.appspot.com/bug?extid=a079f084653164a652d1
+Signed-off-by: Deepanshu Kartikey <kartikey406@gmail.com>
+Signed-off-by: Sven Eckelmann <sven@narfation.org>
+Origin: upstream, https://git.open-mesh.org/batman-adv.git/commit/745e4677a44d6ba07a82ea8a23cce34f0a8fcfbe
+
+--- a/net/batman-adv/bat_iv_ogm.c
++++ b/net/batman-adv/bat_iv_ogm.c
+@@ -1292,7 +1292,7 @@ batadv_iv_ogm_update_seqnos(const struct ethhdr *ethhdr,
+ 		return BATADV_NO_DUP;
+ 
+ 	orig_ifinfo = batadv_orig_ifinfo_new(orig_node, if_outgoing);
+-	if (WARN_ON(!orig_ifinfo)) {
++	if (!orig_ifinfo) {
+ 		batadv_orig_node_put(orig_node);
+ 		return 0;
+ 	}
