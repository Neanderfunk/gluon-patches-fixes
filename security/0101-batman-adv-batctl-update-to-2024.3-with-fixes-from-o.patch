+ 
+-	unicast_packet = (struct batadv_unicast_packet *)skb->data;
+ 	vid = batadv_get_vid(skb, hdr_len);
++	unicast_packet = (struct batadv_unicast_packet *)skb->data;
+ 	ethhdr = (struct ethhdr *)(skb->data + hdr_len);
