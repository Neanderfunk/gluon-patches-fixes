From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Freifunk im Neanderland <projekt@neanderfunk.de>
Date: Sun, 4 Oct 2026 13:40:00 +0200
Subject: autoupdater: stop reading hostile manifest responses instead of
 sitting them out

The mirrors speak plain HTTP in most sites. Signatures protect the content
of a manifest, but not the way to it: anyone on the path can keep a node
busy without any signature.

- A line longer than MAX_LINE_LENGTH made the parser give up without
  draining the socket. Nobody read it any more, and the run stood until
  TIMEOUT_MSEC (300 s), printing the error again on every further data
  event. The transfer is now aborted right away.
- The signature area had no upper bound: every valid hex line cost an
  allocation plus a realloc of the array, and an endless response kept the
  run alive. The whole response is now capped at MAX_MANIFEST_BYTES (1 MiB,
  real manifests stay far below even with the old line formats for every
  model), the number of signatures at MAX_SIGNATURES (64).
- Unparsable lines in the signature area were logged one by one (daemon.err,
  and to remote syslog where configured). They are now counted and reported
  once per run.

A rejected response ends the attempt for this mirror with the new error
"Response rejected by the receiver"; the autoupdater goes on with the next
mirror as on any download error. Valid manifests are parsed as before.

TLS (35f5cef) takes an attacker off the path, not off a compromised mirror,
and does not touch the parser; sites still carry http:// mirrors.

Signed-off-by: Freifunk im Neanderland <projekt@neanderfunk.de>
---
 admin/autoupdater/src/autoupdater.c | 30 +++++++++++++++++++++++++++--
 admin/autoupdater/src/manifest.c    | 26 +++++++++++++++----------
 admin/autoupdater/src/manifest.h    |  9 ++++++++-
 admin/autoupdater/src/uclient.c     | 11 +++++++++++
 admin/autoupdater/src/uclient.h     |  1 +
 5 files changed, 64 insertions(+), 13 deletions(-)

diff --git a/admin/autoupdater/src/autoupdater.c b/admin/autoupdater/src/autoupdater.c
index 2d630a9..0786434 100644
--- a/admin/autoupdater/src/autoupdater.c
+++ b/admin/autoupdater/src/autoupdater.c
@@ -30,6 +30,10 @@
 
 
 #define MAX_LINE_LENGTH 512
+/* Upper bound for a whole manifest response, signature area included. Real
+ * manifests stay far below (a few hundred KiB even with the old line formats
+ * for every model); this only stops endless or padded responses. */
+#define MAX_MANIFEST_BYTES (1024 * 1024)
 #define STRINGIFY(str) #str
 
 static const char *const download_d_dir = "/usr/lib/autoupdater/download.d";
@@ -45,6 +49,8 @@ struct recv_manifest_ctx {
 	struct manifest m;
 	char buf[MAX_LINE_LENGTH + 1];
 	char *ptr;
+	size_t received;
+	bool rejected;
 };
 
 struct recv_image_ctx {
@@ -193,16 +199,29 @@ static void recv_manifest_cb(struct uclient *cl) {
 	char *newline;
 	int len;
 
+	if (ctx->rejected)
+		return;
+
 	while (true) {
 		if (ctx->ptr - ctx->buf == MAX_LINE_LENGTH) {
 			fputs("autoupdater: error: encountered manifest line exceeding limit of " STRINGIFY(MAX_LINE_LENGTH) " characters\n", stderr);
-			break;
+			ctx->rejected = true;
+			uclient_reject(cl);
+			return;
 		}
 		len = uclient_read_account(cl, ctx->ptr, MAX_LINE_LENGTH - (ctx->ptr - ctx->buf));
 		if (len <= 0)
 			break;
 		ctx->ptr[len] = '\0';
 
+		ctx->received += len;
+		if (ctx->received > MAX_MANIFEST_BYTES) {
+			fputs("autoupdater: error: manifest exceeds limit of " STRINGIFY(MAX_MANIFEST_BYTES) " bytes\n", stderr);
+			ctx->rejected = true;
+			uclient_reject(cl);
+			return;
+		}
+
 		char *line = ctx->buf;
 		while (true) {
 			newline = strchr(line, '\n');
@@ -210,7 +229,12 @@ static void recv_manifest_cb(struct uclient *cl) {
 				break;
 			*newline = '\0';
 
-			parse_line(line, &ctx->m, ctx->s->branch, platforminfo_get_image_name());
+			if (!parse_line(line, &ctx->m, ctx->s->branch, platforminfo_get_image_name())) {
+				fputs("autoupdater: error: manifest has more than " STRINGIFY(MAX_SIGNATURES) " signatures\n", stderr);
+				ctx->rejected = true;
+				uclient_reject(cl);
+				return;
+			}
 			line = newline + 1;
 		}
 
@@ -291,6 +315,8 @@ static bool autoupdate(const char *mirror, struct settings *s, int lock_fd) {
 	/* Download manifest */
 	ecdsa_sha256_init(&m->hash_ctx);
 	int err_code = get_url(manifest_url, recv_manifest_cb, &manifest_ctx, -1, s->old_version);
+	if (m->garbage_signatures)
+		fprintf(stderr, "autoupdater: warning: %zu unparsable line(s) in signature area\n", m->garbage_signatures);
 	if (err_code != 0) {
 		fprintf(stderr, "autoupdater: warning: error downloading manifest: %s\n", uclient_get_errmsg(err_code));
 		interrupted = uclient_interrupted_signal(err_code);
diff --git a/admin/autoupdater/src/manifest.c b/admin/autoupdater/src/manifest.c
index 7b721f9..a709f1a 100644
--- a/admin/autoupdater/src/manifest.c
+++ b/admin/autoupdater/src/manifest.c
@@ -56,14 +56,18 @@ static bool parse_rfc3339(const char *input, time_t *date) {
 }
 
 
-void parse_line(char *line, struct manifest *m, const char *branch, const char *image_name) {
+bool parse_line(char *line, struct manifest *m, const char *branch, const char *image_name) {
 	if (m->sep_found) {
+		if (m->n_signatures >= MAX_SIGNATURES)
+			return false;
+
 		ecdsa_signature_t *sig = safe_malloc(sizeof(ecdsa_signature_t));
 
 		if (!parsehex(sig, line, sizeof(*sig))) {
 			free(sig);
-			fprintf(stderr, "autoupdater: warning: garbage in signature area: %s\n", line);
-			return;
+			/* counted and reported once by the caller, not once per line */
+			m->garbage_signatures++;
+			return true;
 		}
 		m->n_signatures++;
 		m->signatures = safe_realloc(m->signatures, m->n_signatures * sizeof(ecdsa_signature_t *));
@@ -80,14 +84,14 @@ void parse_line(char *line, struct manifest *m, const char *branch, const char *
 
 		else if (!strncmp(line, "DATE=", 5)) {
 			if (m->date_ok)
-				return;
+				return true;
 
 			m->date_ok = parse_rfc3339(&line[5], &m->date);
 		}
 
 		else if (!strncmp(line, "PRIORITY=", 9)) {
 			if (m->priority_ok)
-				return;
+				return true;
 
 			m->priority = strtof(&line[9], NULL);
 			m->priority_ok = true;
@@ -95,7 +99,7 @@ void parse_line(char *line, struct manifest *m, const char *branch, const char *
 
 		else {
 			if (m->model_ok)
-				return;
+				return true;
 
 			char *model = strtok(line, " ");
 			char *version = strtok(NULL, " ");
@@ -103,13 +107,13 @@ void parse_line(char *line, struct manifest *m, const char *branch, const char *
 			char *imagesize = strtok(NULL, " ");
 			char *filename = strtok(NULL, " ");
 			if (!filename || strtok(NULL, " "))
-				return;
+				return true;
 
 			if (strcmp(model, image_name) != 0)
-				return;
+				return true;
 
 			if (!parsehex(m->image_hash, checksum, ECDSA_SHA256_HASH_SIZE))
-				return;
+				return true;
 
 			{
 
@@ -118,7 +122,7 @@ void parse_line(char *line, struct manifest *m, const char *branch, const char *
 				errno = 0;
 				unsigned long long val = strtoull(imagesize, &endptr, 10);
 				if (errno || *endptr || val > SSIZE_MAX)
-					return;
+					return true;
 
 				m->imagesize = val;
 			}
@@ -129,4 +133,6 @@ void parse_line(char *line, struct manifest *m, const char *branch, const char *
 			m->model_ok = true;
 		}
 	}
+
+	return true;
 }
diff --git a/admin/autoupdater/src/manifest.h b/admin/autoupdater/src/manifest.h
index 0322265..b9e4039 100644
--- a/admin/autoupdater/src/manifest.h
+++ b/admin/autoupdater/src/manifest.h
@@ -25,11 +25,18 @@ struct manifest {
 	ssize_t imagesize;
 
 	size_t n_signatures;
+	size_t garbage_signatures;
 	ecdsa_signature_t **signatures;
 	ecdsa_sha256_context_t hash_ctx;
 };
 
 
+/* More signatures than this are never needed (a site has only a handful of
+ * public keys), and each one costs an allocation. */
+#define MAX_SIGNATURES 64
+
+
 void clear_manifest(struct manifest *m);
 
-void parse_line(char *line, struct manifest *m, const char *branch, const char *image_name);
+/* Returns false if the manifest has to be rejected (too many signatures). */
+bool parse_line(char *line, struct manifest *m, const char *branch, const char *image_name);
diff --git a/admin/autoupdater/src/uclient.c b/admin/autoupdater/src/uclient.c
index 2ddfae9..a745080 100644
--- a/admin/autoupdater/src/uclient.c
+++ b/admin/autoupdater/src/uclient.c
@@ -22,6 +22,7 @@ enum uclient_own_error_code {
 	UCLIENT_ERROR_TOO_MANY_REDIRECTS,
 	UCLIENT_ERROR_CONNECTION_RESET_PREMATURELY,
 	UCLIENT_ERROR_SIZE_MISMATCH,
+	UCLIENT_ERROR_REJECTED,
 	UCLIENT_ERROR_STATUS_CODE = 1024,
 	UCLIENT_ERROR_INTERRUPTED = 2048,
 };
@@ -59,6 +60,8 @@ const char *uclient_get_errmsg(int code) {
 		return "Connection reset prematurely";
 	case UCLIENT_ERROR_SIZE_MISMATCH:
 		return "Incorrect file size";
+	case UCLIENT_ERROR_REJECTED:
+		return "Response rejected by the receiver";
 	default:
 		return "Unknown error";
 	}
@@ -78,6 +81,14 @@ static void request_done(struct uclient *cl, int err_code) {
 }
 
 
+/* Stop the transfer right away: the receiver has decided that the response is
+ * not acceptable. Without this, a response the parser has given up on is still
+ * read until the server closes the connection or TIMEOUT_MSEC expires. */
+void uclient_reject(struct uclient *cl) {
+	request_done(cl, UCLIENT_ERROR_REJECTED);
+}
+
+
 static void header_done_cb(struct uclient *cl) {
 	const struct blobmsg_policy policy = {
 		.name = "content-length",
diff --git a/admin/autoupdater/src/uclient.h b/admin/autoupdater/src/uclient.h
index c1599bc..630181e 100644
--- a/admin/autoupdater/src/uclient.h
+++ b/admin/autoupdater/src/uclient.h
@@ -31,3 +31,4 @@ ssize_t uclient_read_account(struct uclient *cl, char *buf, int len);
 int get_url(const char *url, void (*read_cb)(struct uclient *cl), void *cb_data, ssize_t len, const char *firmware_version);
 const char *uclient_get_errmsg(int code);
 int uclient_interrupted_signal(int code);
+void uclient_reject(struct uclient *cl);
